{
  "id": "git-sync",
  "name": "Git 同步",
  "version": "4.0.0",
  "description": "为 Typora 笔记提供本地快照与统一笔记仓库同步",
  "author": "BetterTypora",
  "license": "MIT",
  "main": "main.js",
  "style": "style.css",
  "enabled": true,
  "hotkeys": [
    { "command": "git-sync:toggle-panel", "key": "Ctrl+Shift+V", "when": "always" },
    { "command": "git-sync:save-snapshot", "key": "Ctrl+Shift+S", "when": "editorFocus" },
    { "command": "git-sync:sync", "key": "Ctrl+Shift+Y", "when": "always" }
  ],
  "settings": {
    "repositoryProfiles": "[]",
    "repoPath": "",
    "remoteName": "origin",
    "autoFetchOnOpen": false,
    "maxStatusFiles": 80
  },
  "settingsSchema": [
    {
      "key": "autoFetchOnOpen",
      "label": "打开文档时检查远程",
      "type": "boolean",
      "default": false,
      "desc": "只获取远程状态，不自动合并或覆盖本地内容"
    },
    {
      "key": "maxStatusFiles",
      "label": "最多显示改动文件数",
      "type": "number",
      "default": 80,
      "min": 10,
      "max": 500,
      "desc": "状态面板中展示的文件数量"
    }
  ]
}
